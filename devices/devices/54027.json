            "RegLen": 1,
            "Decimal": 3,
            "Warning": [
                {
                    "Condition": "ErrorCode == 0 ",
                    "Color": "#07c160",
                    "Level": "Info",
                    "Message": "The equipment is working properly."
                },
                {
                    "Condition": "ErrorCode == 2000 '",
                    "Color": "#ff4d4f",
                    "Level": "Alarm",
                    "Message": "Time error,Power cycle the meter.If the problem persists, Please contact technical support."
                },
                {
                    "Condition": "ErrorCode == 4000 ",
                    "Color": "#ff4d4f",
                    "Level": "Alarm",
                    "Message": "RTC error,Power cycle the meter.If the problem persists, Please contact technical support."
                },
                {
                    "Condition": "ErrorCode == 8000 ",
                    "Color": "#ff4d4f",
                    "Level": "Alarm",
                    "Message": "Low Power, please replace the battery."
                },
                {
                    "Condition": "ErrorCode != 0  && ErrorCode != 2000&& ErrorCode != 4000 && ErrorCode != 8000",
                    "Color": "#ff4d4f",
                    "Level": "Alarm",
                    "Message": "Radar board is not working properly,Power cycle the meter.If the problem persists, Please contact technical support."
                }
            ]
        }
